diff --git a/packages/tui/src/component/peer-pane.tsx b/packages/tui/src/component/peer-pane.tsx
new file mode 100644
index 0000000..e89503e
--- /dev/null
+++ b/packages/tui/src/component/peer-pane.tsx
@@ -0,0 +1,87 @@
+import { For, createSignal, onCleanup, onMount } from "solid-js"
+import { readFile } from "node:fs/promises"
+import path from "node:path"
+import { useTheme } from "../context/theme"
+
+interface Line {
+  readonly ts: number
+  readonly kind: string
+  readonly text: string
+}
+
+const SHOWN = 60
+
+/**
+ * Live mirror of the other agent in a baton pair. The relay plugin appends every
+ * turn boundary, tool call, changed file and assistant message to a JSONL feed;
+ * this pane tails that file. Read-only on purpose — the peer is driven from its
+ * own session (swap halves with alt+left / alt+right), so two prompts never fight
+ * for the keyboard.
+ */
+export function PeerPane(props: { sessionID: string; feed?: string /* feed directory */ }) {
+  const theme = useTheme()
+  const [lines, setLines] = createSignal<Line[]>([])
+
+  onMount(() => {
+    let alive = true
+    const tick = async () => {
+      if (!props.feed) return
+      const file = path.join(props.feed, `${props.sessionID.replace(/[^a-zA-Z0-9._-]/g, "_")}.jsonl`)
+      const raw = await readFile(file, "utf8").catch(() => undefined)
+      if (raw === undefined || !alive) return
+      const parsed = raw.split("\n").flatMap((line) => {
+        if (!line.trim()) return []
+        try {
+          return [JSON.parse(line) as Line]
+        } catch {
+          return []
+        }
+      })
+      setLines(parsed.slice(-SHOWN))
+    }
+    void tick()
+    const timer = setInterval(() => void tick(), 700)
+    onCleanup(() => {
+      alive = false
+      clearInterval(timer)
+    })
+  })
+
+  const color = (kind: string) => {
+    if (kind === "error") return theme.text.feedback.error.base
+    if (kind === "say") return theme.text.base
+    if (kind === "files") return theme.text.feedback.success.base
+    if (kind === "tool") return theme.text.feedback.warning.base
+    return theme.text.muted
+  }
+
+  return (
+    <box
+      flexDirection="column"
+      height="100%"
+      minWidth={0}
+      backgroundColor={theme.background.raised.base}
+      paddingLeft={1}
+      paddingRight={1}
+    >
+      <box flexShrink={0} paddingBottom={1}>
+        <text fg={theme.text.muted}>watching {props.sessionID.slice(0, 14)}</text>
+      </box>
+      <scrollbox flexGrow={1} minHeight={0} scrollbarOptions={{ visible: false }}>
+        <For each={lines()}>
+          {(line) => (
+            <box flexDirection="row">
+              <text fg={theme.text.muted}>{clock(line.ts)} </text>
+              <text fg={color(line.kind)} wrapMode="word">
+                {" "}
+                {line.kind.padEnd(5)} {line.text}
+              </text>
+            </box>
+          )}
+        </For>
+      </scrollbox>
+    </box>
+  )
+}
+
+const clock = (ts: number) => new Date(ts).toISOString().slice(11, 19)
